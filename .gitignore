# Track source, documentation, models, and generated results.
*
!*/
!.gitignore
!*.ipynb
!*.py
!*.R
!*.r
!*.sh
!*.sql
!*.md
!*.toml
!requirements*.txt
!environment*.yml
!environment*.yaml

# Local Git history backup and notebook caches
.git-backup-*/
.ipynb_checkpoints/
__pycache__/
.venv/
venv/

# Input data (including labels) and binary datasets
/data/
*.feather
*.parquet
*.arrow
*.csv
*.tsv
*.xlsx
*.xls
*.h5
*.hdf5
*.npy
*.npz
*.pkl
*.pickle
*.joblib
.DS_Store

# Trained models and generated reports/results
!*.txt
!*.json
!*.joblib
!*.csv
!**/*_predictions.parquet

# Always exclude raw input data and local history backups
/data/
.git-backup-*/
